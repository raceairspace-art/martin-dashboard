# Marketplace pause switch (single source of truth; read by scripts/build_dist.sh
# and scripts/ingest_marketplace.py; an exported env var of the same name wins).
#   1 = paused: no watchlist / daily hunt / special searches / last_diff / favorites
#       baked into dist, marketplace items dropped from the built feed, ingest refuses.
#   0 = live: normal behaviour. See PAUSED.md for restore steps.
MARKETPLACE_PAUSED=1
MARKETPLACE_PAUSED_SINCE=2026-11-03
MARKETPLACE_PAUSED_MESSAGE="Marketplace paused — no active searches"
